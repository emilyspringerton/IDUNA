# iduna.env -- IDUNA's settings, one NAME=value per line (copy this file to iduna.env). Lines starting with # are skipped.
# Nothing here is required: with no iduna.env IDUNA listens on 127.0.0.1:8080, keeps its data in var/iduna.db and makes
# its signing key (iduna-key.json) on first run. Keep iduna.env and iduna-key.json private: never commit or share them.

# Where to listen. 0.0.0.0:8080 opens it to your network (the firewall will ask).
IDUNA_ADDR=127.0.0.1:8080
# The address people reach it at (used in links and redirects).
BASE_URL=http://localhost:8080

# The WOTAN arcade (release bundles carry it in wotan/). RUN serves it on WOTAN_ADDR when that folder exists.
# WOTAN_SITE_DIR=wotan
WOTAN_ADDR=127.0.0.1:8090
# Hosts a sign-in may return to. Add this computer's name or LAN address to play from a phone on your network.
SSO_ALLOWED_REDIRECT_HOSTS=localhost,127.0.0.1

# Optional, each turns one feature on (see the IDUNA README for the full list):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# REDGARDEN_TICKET_SECRET=
# IDUNA_HEC_TOKEN=
