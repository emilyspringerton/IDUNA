# IDUNA systemd user unit — process supervision for the IAM service
#
# Deploy:
#   mkdir -p ~/.config/systemd/user
#   cp iduna.service ~/.config/systemd/user/iduna.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now iduna.service
#   systemctl --user status iduna.service
#
# Build the binary first:
#   cd /home/fatbaby/IDUNA
#   go build -o ~/.local/bin/iduna .
#
# Required env vars (set in EnvironmentFile or export before enabling):
#   JWT_SECRET       — random string, min 32 chars
#   JWT_ISSUER       — e.g. "iduna.einhorn.internal"
#   SERVER_PORT      — optional, defaults to 8080
#   APPLES_GIT_DIR   — /home/fatbaby/APPLES (enables auto-sync on every Apple POST)
#
# No MYSQL_DSN needed — embedded SQLite backend runs in-process.

[Unit]
Description=IDUNA IAM Service — Einhorn Industrial agent authentication
After=network.target
Documentation=file:///home/fatbaby/IDUNA/docs

[Service]
Type=simple
WorkingDirectory=/home/fatbaby/IDUNA
EnvironmentFile=-%h/.config/iduna/env
ExecStart=%h/.local/bin/iduna
# Gate the unit's "started" state on the HTTP listener actually accepting
# connections, not just the process forking — Type=simple only guarantees
# the latter. Dependent units (emily-system.service, After=iduna.service)
# don't proceed until ExecStartPost commands finish.
ExecStartPost=/bin/sh -c 'for i in $(seq 1 30); do curl -sf -o /dev/null http://localhost:8080/health && exit 0; sleep 1; done; echo "iduna health check failed after 30s" >&2; exit 1'
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Founder real-time, 2026-09-08 (PII audit): var/*.db defaulted to world-readable (no explicit
# UMask meant the process inherited whatever umask its parent happened to have). 0027 means new
# files are created owner rw, group r, other nothing -- SQLite's own DB/-wal/-shm files included.
UMask=0027

# Resource limits. MemoryMax bumped 256M -> 512M, 2026-09-08: found live, mid-PII-audit
# (unrelated to that work) -- journalctl showed real, recurring OOM-kills against the 256M
# ceiling starting well before this session's own restarts (first at 18:16 UTC), then
# compounding when this session's own heavy Apple-filing activity triggered frequent
# apples-git sync subprocesses. Host has 9GB+ available (checked via `free -h`), so this is a
# safe, immediate stopgap -- the actual root cause of the memory growth (a specific handler? the
# apples-git sync path itself?) is a real, separate, NOT diagnosed-here investigation.
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=default.target
